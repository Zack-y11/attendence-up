{
  "name": "attendence-up",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "corepack pnpm --parallel --filter @attendence-up/api --filter @attendence-up/web dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "corepack pnpm --filter @attendence-up/api --filter @attendence-up/web test",
    "typecheck": "corepack pnpm --filter @attendence-up/shared --filter @attendence-up/api --filter @attendence-up/web typecheck",
    "db:deploy": "corepack pnpm --filter @attendence-up/api exec prisma migrate deploy",
    "db:generate": "corepack pnpm --filter @attendence-up/api exec prisma generate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.70.1"
  }
}
