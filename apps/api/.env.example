# Local: Postgres from `docker compose` in this repo.
# Production (Fly secret): Neon → your project → Connect → URI, direct (not pooled).
# Use the string Neon shows. It should include sslmode=require.
# No trailing spaces. Do not commit the real URL.
DATABASE_URL=postgresql://attendence:attendence@localhost:5434/attendence?schema=public

# Clerk Dashboard → your app → API keys → Secret key.
# Local development: sk_test_...
# Production (Fly secret): sk_live_... from the Production instance.
CLERK_SECRET_KEY=sk_test_replace_me

# Exact browser origin, no trailing slash.
# Local: http://localhost:5173
# Production (Fly secret): the Vercel URL, for example https://attendence-up.vercel.app
WEB_ORIGIN=http://localhost:5173

# Local API port. Fly sets PORT=8080 in fly.toml. Leave this at 3001 on your machine.
PORT=3001
